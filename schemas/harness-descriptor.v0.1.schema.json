{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cogiens:chg:schema:harness-descriptor:v0.1",
  "title": "CHG Harness Descriptor v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "adapter_id",
    "adapter_version",
    "harness_version",
    "transport",
    "capabilities",
    "auth_modes",
    "platforms",
    "status"
  ],
  "properties": {
    "contract_version": { "const": "chg.adapter.v0.1" },
    "adapter_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
    "adapter_version": { "type": "string", "minLength": 1 },
    "harness_version": { "type": "string", "minLength": 1 },
    "transport": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "required": ["streaming", "approvals", "cancel", "resume", "steer", "artifacts", "usage"],
      "properties": {
        "streaming": { "type": "boolean" },
        "approvals": { "type": "boolean" },
        "cancel": { "type": "boolean" },
        "resume": { "type": "boolean" },
        "steer": { "type": "boolean" },
        "session_fork": { "type": "boolean" },
        "structured_output": { "type": "boolean" },
        "file_diff": { "type": "boolean" },
        "artifacts": { "type": "boolean" },
        "usage": { "type": "boolean" },
        "mcp": { "type": "boolean" },
        "acp": { "type": "boolean" },
        "remote_execution": { "type": "boolean" }
      }
    },
    "experimental_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "auth_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["none", "provider-login", "api-key", "oauth", "service-account"] }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["linux", "windows", "macos"] }
    },
    "status": { "enum": ["experimental", "candidate", "certified", "deprecated"] }
  }
}
