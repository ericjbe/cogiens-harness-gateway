{
  "name": "@cogiens/harness-gateway",
  "version": "0.3.0-alpha.1",
  "description": "Vendor-neutral harness gateway and harness bridge for federating stateful AI agent runtimes",
  "keywords": [
    "ai-agent-harness",
    "harness-gateway",
    "harness-bridge",
    "agent-runtime",
    "multi-agent",
    "interoperability",
    "codex"
  ],
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ericjbe/cogiens-harness-gateway.git"
  },
  "homepage": "https://github.com/ericjbe/cogiens-harness-gateway#readme",
  "bugs": {
    "url": "https://github.com/ericjbe/cogiens-harness-gateway/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "verify:schemas": "node scripts/verify-schemas.mjs",
    "verify:boundary": "node scripts/verify-public-boundary.mjs",
    "verify:discoverability": "node scripts/verify-discoverability.mjs",
    "verify:federation": "node scripts/verify-federation-registry.mjs",
    "verify": "npm run verify:schemas && npm run verify:boundary && npm run verify:discoverability && npm run verify:federation && npm test && node scripts/verify-md-links.mjs",
    "example:mock": "node examples/run-mock.mjs",
    "gateway": "node apps/gateway/src/server.mjs",
    "gateway:detect": "node scripts/detect-adapters.mjs",
    "gateway:cli": "node scripts/chg.mjs",
    "verify:md-links": "node scripts/verify-md-links.mjs"
  }
}
